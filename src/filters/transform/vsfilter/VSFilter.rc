// Version information for the CSRI-only VSFilter build.

#include "version.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XY_VSFILTER_VERSION_NUM
 PRODUCTVERSION XY_VSFILTER_VERSION_NUM
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "xy-VSFilter Team"
            VALUE "FileDescription", "xy-VSFilter text subtitle renderer (CSRI)"
            VALUE "FileVersion", XY_VSFILTER_VERSION_STR
            VALUE "InternalName", "VSFilter"
            VALUE "LegalCopyright", "Copyright (C) 2001-2012 Yu Zhuohuang, Gabest et. al."
            VALUE "OriginalFilename", "VSFilter.dll"
            VALUE "ProductName", "VSFilter"
            VALUE "ProductVersion", XY_VSFILTER_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
